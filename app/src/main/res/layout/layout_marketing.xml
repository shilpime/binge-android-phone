<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1">

        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".75">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLine_bottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent=".70" />

            <ImageView
                android:id="@+id/main_iv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/guideLine_bottom"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/heading"
                style="@style/TSTextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/view_margin_large"
                android:gravity="center"
                android:padding="@dimen/view_margin_small"
                android:textSize="@dimen/text_size_28"
                app:layout_constraintBottom_toTopOf="@id/sub_heading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guideLine_bottom"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Streaming All Apps" />

            <TextView
                android:id="@+id/sub_heading"
                style="@style/TSTextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/view_margin_large"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/view_margin_smallest"
                android:textColor="@color/pink_50"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heading"
                tools:text="All major content streaming apps part of Binge. Streaming all apps from one place." />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>
