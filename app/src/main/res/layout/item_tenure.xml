<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_16">

        <LinearLayout
            android:id="@+id/ll_save_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/view_margin_small"
            android:background="@drawable/tenure_save_tag_bg"
            android:paddingStart="@dimen/margin_6"
            android:paddingTop="@dimen/margin_2"
            android:paddingEnd="@dimen/margin_6"
            android:paddingBottom="@dimen/margin_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible"
            android:visibility="visible"
            >

            <TextView
                android:id="@+id/tv_save_tag"
                style="@style/TSTextDefault"
                android:textSize="@dimen/text_size_10"
                android:layout_width="wrap_content"
                android:lineSpacingExtra="0sp"
                android:layout_height="wrap_content"
                tools:text="Save 15%" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardMaxElevation="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_save_tag"
            app:strokeColor="@color/stroke_color"
            app:strokeWidth="@dimen/dp_1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingHorizontal="@dimen/view_margin_small"
                android:paddingVertical="@dimen/view_margin_small"
                android:background="@color/darkSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_tenure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:maxHeight="25dp"
                    android:maxWidth="25dp"
                    tools:srcCompat="@drawable/ic_tenure_month" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_tenure_price_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/view_margin_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_tenure_price"
                    app:layout_constraintStart_toEndOf="@id/iv_tenure"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_tenure_title"
                        style="@style/TSTextMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tv_tenure_subtitle"
                        tools:text="Monthly" />

                    <TextView
                        android:id="@+id/tv_tenure_subtitle"
                        style="@style/TSTextMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="?colorOnSecondary"
                        android:textSize="@dimen/text_size_14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_tenure_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="1 Month" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_tenure_price"
                    style="@style/TSTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:textColor="?colorOnSecondary"
                    android:textSize="@dimen/text_size_14"
                    app:layout_constraintBottom_toBottomOf="@id/cl_tenure_price_info"
                    app:layout_constraintEnd_toStartOf="@id/tv_tenure_price_offered"
                    app:layout_constraintTop_toTopOf="@id/cl_tenure_price_info"
                    app:strikeThrough="@{true}"
                    tools:text="Rs. 299" />

                <TextView
                    android:id="@+id/tv_tenure_price_offered"
                    style="@style/TSTextMedium"
                    android:textColor="@color/text_purple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintBottom_toBottomOf="@id/cl_tenure_price_info"
                    app:layout_constraintEnd_toStartOf="@id/rb_tenure"
                    app:layout_constraintTop_toTopOf="@id/cl_tenure_price_info"
                    tools:text="Rs. 299" />


                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_tenure"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/radio_button_selector"
                    android:button="@null"
                    android:scaleX="0.5"
                    android:scaleY="0.5"
                    app:layout_constraintBottom_toBottomOf="@id/cl_tenure_price_info"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cl_tenure_price_info" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_current_tenure"
            style="@style/TSText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_6"
            android:textColor="@color/darkOnSecondary"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardView"
            android:text="You are currently on this plan."
            tools:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>