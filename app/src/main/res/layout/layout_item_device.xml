<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    >
    <data>
        <variable name="item" type="com.tatasky.binge.data.networking.models.response.DeviceList"/>

        <import type="android.view.View"/>
    </data>
    <LinearLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/other_device"
            android:textSize="@dimen/text_size_14"
            android:layout_marginBottom="@dimen/dimens_7dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <com.tatasky.binge.customviews.CustomMaterialCardView
            app:cardCornerRadius="@dimen/dp_12"
            android:elevation="@dimen/dp_10"
            app:strokeColor="@color/stroke_color"
            app:strokeWidth="@dimen/mtrl_textinput_box_stroke_width_focused"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/view_margin_xlarge"
                android:background="@color/darkHighlight"
                android:paddingStart="@dimen/view_margin_large"
                android:paddingEnd="@dimen/margin_18">

                <ImageView
                    android:id="@+id/ivDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDeviceName"
                    style="@style/TSTextMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:text="@{item.deviceName}"
                    android:layout_marginStart="@dimen/view_margin_medium"
                    android:layout_marginEnd="@dimen/view_margin_medium"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/ivDevice"
                    app:layout_constraintEnd_toStartOf="@id/tvCurrentDevice"
                    app:layout_constraintTop_toTopOf="parent"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvCurrentDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="@dimen/text_size_14"
                    android:text="@string/this_device"
                    android:layout_marginStart="@dimen/view_margin_medium"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivDelete"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/ivDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_delete_device"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/ivSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_active_rb"
                    android:visibility="@{item.primary ? View.VISIBLE : View.GONE, default=gone}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.tatasky.binge.customviews.CustomMaterialCardView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/primary_device_description"
                android:textSize="@dimen/text_size_12"
                android:textFontWeight="400"
                android:textColor="@color/tint_purple_25"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>
            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textFontWeight="400"
                android:layout_alignParentEnd="true"
                android:textColor="@color/tint_purple_25"
                android:maxLines="1"
                android:text="@string/m_out_3"
                android:textSize="@dimen/text_size_12"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>
        </RelativeLayout>
    </LinearLayout>
</layout>