<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_pin_dig_1"
            style="@style/TSTextMedium"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shp_dark_highlight_rect_digits"
            android:gravity="center"
            android:hint="@string/hint_otp_dig_et_guest_login_verify_otp"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/hintColor"
            android:textSize="@dimen/text_size_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/et_pin_dig_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_pin_dig_2"
            style="@style/TSTextMedium"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shp_dark_highlight_rect_digits"
            android:gravity="center"
            android:hint="@string/hint_otp_dig_et_guest_login_verify_otp"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/hintColor"
            android:textSize="@dimen/text_size_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/et_pin_dig_3"
            app:layout_constraintStart_toEndOf="@+id/et_pin_dig_1"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_pin_dig_3"
            style="@style/TSTextMedium"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shp_dark_highlight_rect_digits"
            android:gravity="center"
            android:hint="@string/hint_otp_dig_et_guest_login_verify_otp"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/hintColor"
            android:textSize="@dimen/text_size_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/et_pin_dig_4"
            app:layout_constraintStart_toEndOf="@+id/et_pin_dig_2"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_pin_dig_4"
            style="@style/TSTextMedium"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shp_dark_highlight_rect_digits"
            android:gravity="center"
            android:hint="@string/hint_otp_dig_et_guest_login_verify_otp"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/hintColor"
            android:textSize="@dimen/text_size_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/et_pin_dig_3"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
