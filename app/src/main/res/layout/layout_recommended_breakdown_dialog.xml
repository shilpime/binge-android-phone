<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/view_margin_large"
        android:paddingBottom="@dimen/view_margin_large">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideLine_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".9" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideLine_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".1" />

        <ImageView
            android:id="@+id/iv_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_xxlarge"
            android:contentDescription="@string/sample_iv_desc"
            app:srcCompat="@drawable/ic_subscription_info"
            app:layout_constraintEnd_toEndOf="@id/guideLine_end"
            app:layout_constraintStart_toStartOf="@id/guideLine_start"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_dialog_title"
            style="@style/TSTextMedium"
            android:layout_width="@dimen/margin_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_xxlarge"
            android:paddingStart="@dimen/view_margin_xlarge"
            android:paddingEnd="@dimen/view_margin_xlarge"
            android:gravity="center"
            android:text="@string/recommended_breakdown_title"
            android:textColor="@color/dialog_message_color"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintEnd_toEndOf="@id/guideLine_end"
            app:layout_constraintStart_toStartOf="@id/guideLine_start"
            app:layout_constraintTop_toBottomOf="@id/iv_dialog" />

<!--        <LinearLayout-->
<!--            android:id="@+id/table_layout"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_marginTop="@dimen/view_margin_large"-->
<!--            app:layout_constraintStart_toStartOf="@id/guideLine_start"-->
<!--            app:layout_constraintEnd_toEndOf="@id/guideLine_end"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:orientation="vertical"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_primary"
            style="@style/TSTextMedium"
            android:layout_width="@dimen/margin_0"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/view_margin_xlarge"
            android:layout_marginBottom="@dimen/view_margin_xxlarge"
            android:text="@string/ok_recom_rec_dialog"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideLine_end"
            app:layout_constraintStart_toStartOf="@id/guideLine_start"
            app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
