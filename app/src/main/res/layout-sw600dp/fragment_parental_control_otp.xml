<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.features.parentalcontrol.sidemenu.ParentalControlOtpFragment">

        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/shadowed_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_margin_start"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/margin_20dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_margin_end"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/margin_20" />

        <ImageView
            android:id="@+id/iv_logo_fragment_parental_control_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout"
            app:srcCompat="@drawable/ic_tab_binge_logo" />

        <TextView
            android:id="@+id/tv_header_title_fragment_parental_control_otp"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/title_parental_pin_setup"
            android:textSize="@dimen/text_size_22"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/iv_logo_fragment_parental_control_otp" />

        <TextView
            android:id="@+id/tv_subtitle_fragment_parental_control_otp"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|start"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/tv_header_title_fragment_parental_control_otp"
            tools:text="@string/text_subtitle_guest_login_verify_otp" />

        <include
            android:id="@+id/cl_et_otp_container_fragment_parental_control_otp"
            layout="@layout/layout_otp_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle_fragment_parental_control_otp" />

        <TextView
            android:id="@+id/tv_code_expiry_fragment_parental_control_otp"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical|start"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintEnd_toStartOf="@id/tv_resend_otp_fragment_parental_control_otp"
            app:layout_constraintStart_toStartOf="@id/cl_et_otp_container_fragment_parental_control_otp"
            app:layout_constraintTop_toBottomOf="@id/cl_et_otp_container_fragment_parental_control_otp"
            tools:text="@string/text_code_expiry_guest_login_verify_otp" />

        <TextView
            android:id="@+id/tv_error_fragment_parental_control_otp"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical|start"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/darkError"
            android:textSize="@dimen/text_size_14"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/tv_resend_otp_fragment_parental_control_otp"
            app:layout_constraintStart_toStartOf="@id/cl_et_otp_container_fragment_parental_control_otp"
            app:layout_constraintTop_toBottomOf="@id/cl_et_otp_container_fragment_parental_control_otp"
            tools:text="Incorrect OTP" />

        <TextView
            android:id="@+id/tv_resend_otp_fragment_parental_control_otp"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:gravity="center_vertical|end"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/resend_otp"
            android:textColor="@color/button_color_tertiary"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/cl_et_otp_container_fragment_parental_control_otp"
            app:layout_constraintTop_toBottomOf="@id/cl_et_otp_container_fragment_parental_control_otp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>