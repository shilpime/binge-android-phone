<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:animateLayoutChanges="true"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sample_iv_desc"
            android:paddingStart="@dimen/view_margin_large"
            android:paddingTop="@dimen/view_margin_small"
            android:paddingEnd="@dimen/view_margin_large"
            android:paddingBottom="@dimen/view_margin_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back_key" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_view_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintEnd_toStartOf="@id/guidelineSearchContainerEnd"
            android:elevation="0dp"
            app:cardCornerRadius="@dimen/corner_radius_6"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/stroke_color"
            app:strokeWidth="@dimen/mtrl_textinput_box_stroke_width_focused">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_searchview"
                android:layout_width="match_parent"
                android:background="@color/search_view_background"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:transitionGroup="true">

                <ImageView
                    android:id="@+id/iv_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimens_10dp"
                    android:contentDescription="@string/sample_iv_desc"
                    android:layout_marginVertical="@dimen/dimens_10dp"
                    app:layout_constraintTop_toTopOf="@id/et_search"
                    app:layout_constraintBottom_toBottomOf="@id/et_search"
                    app:layout_constraintStart_toStartOf="parent"
                    app:srcCompat="@drawable/ic_icon_search" />


                <com.tatasky.binge.customviews.CustomSearchView
                    android:id="@+id/et_search"
                    style="@style/TSText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimens_40dp"
                    android:layout_marginHorizontal="@dimen/dimens_8dp"
                    android:background="@null"
                    android:clipToPadding="true"
                    android:focusable="false"
                    android:paddingStart="-16dp"
                    android:focusableInTouchMode="true"
                    app:defaultQueryHint="@string/search_hint"
                    app:closeIcon="@null"
                    android:focusedByDefault="false"
                    android:singleLine="true"
                    android:theme="@style/AppTheme.SearchView.SearchViewTheme"
                    app:goIcon="@drawable/ic_search"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_search"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--<ImageView
                    android:id="@+id/iv_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:paddingStart="@dimen/view_margin_small"
                    android:paddingEnd="@dimen/view_margin_small"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_cross"
                    app:tint="@color/launcher_background" />-->
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineSearchContainerEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="52dp" />

        <ImageView
            android:id="@+id/iv_close"
            increaseTouch="@{8}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.6"
            app:layout_constraintStart_toEndOf="@id/guidelineSearchContainerEnd"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_cross"
            tools:visibility="gone" />

        <ImageView
            android:id="@+id/iv_speak_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.8"
            app:layout_constraintStart_toEndOf="@id/guidelineSearchContainerEnd"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_mic_new"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
