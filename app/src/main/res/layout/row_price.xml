<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="label"
            type="String" />

        <variable
            name="price"
            type="String" />
        <variable
            name="nPrice"
            type="String" />
        <variable
            name="hide"
            type="Boolean" />
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:id="@+id/root"
        android:visibility="@{hide?View.GONE:View.VISIBLE, default=visible}"
        android:paddingVertical="@dimen/view_margin_smallest"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_price_label"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{label}"
            android:textSize="@dimen/text_size_16"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/tv_price"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="@dimen/view_margin_large"
            android:layout_height="@dimen/view_margin_large"
            app:srcCompat="@drawable/ic_info1"
            android:layout_marginStart="@dimen/view_margin_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/info_icon"
            app:layout_constraintStart_toEndOf="@id/tv_price_label"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_price"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{(price!=null &amp;&amp;!price.empty)?String.format(@string/rupees, price) : String.format(@string/negative_rupees, nPrice) }"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>