<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem" />
    </data>

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/ic_sqare_genre_lang_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_genre"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/sample_iv_desc"
            android:padding="2dp"
            android:scaleType="fitCenter" />


        <TextView
            android:id="@+id/tv_content_title"
            style="@style/TSText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:text="@{contentItem.title}"
            android:textFontWeight="500"
            android:textSize="@dimen/text_size_12" />
    </LinearLayout>
</layout>