<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="selectedPack"
            type="com.tatasky.binge.data.networking.models.response.PartnerPacks" />

        <import type="android.text.TextUtils" />

        <variable
            name="firstTimeLogin"
            type="Boolean" />

        <variable
            name="primeVisible"
            type="Boolean" />

        <variable
            name="regionalAppInfo"
            type="com.tatasky.binge.data.networking.models.response.PartnerPacks.RegionalAppInfo" />

        <import type="android.text.InputType" />

        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/view_margin_large"
            app:srcCompat="@drawable/ic_back_key" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_subscription"
            style="@style/Widget.AppTheme.ButtonStyle.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/iv_back"
            android:layout_alignParentEnd="true"
            android:minHeight="@dimen/margin_0"
            android:text="@{!TextUtils.isEmpty(selectedPack.planCTADetails.cancellationOptions.cancelPlanText) ? selectedPack.planCTADetails.cancellationOptions.cancelPlanText : @string/cancel_subscription, default=@string/cancel_subscription}"
            android:textColor="@color/darkButtonTertiary"
            android:textSize="@dimen/text_size_16"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/iv_back"
            android:fillViewport="true">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_combo_plan_root"
                    android:layout_width="@dimen/dimen_0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/my_plan_margin"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:visibility="gone"
                    >

                    <ImageView
                        android:id="@+id/iv_tp_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/large_binge_logo" />

                    <TextView
                        android:id="@+id/tv_combo_sub_landing_title"
                        style="@style/TSTextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15"
                        android:gravity="center"
                        android:lineSpacingExtra="4sp"
                        android:text="@string/my_plan"
                        android:textSize="@dimen/text_size_28"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_tp_logo" />



                    <include
                        android:id="@+id/combo_selected_pack_card"
                        layout="@layout/layout_freemium_combo_pack_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/view_margin_xlarge"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_combo_sub_landing_title"
                        app:pack="@{selectedPack}" />


                    <TextView
                        android:id="@+id/tv_combo_footer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:text="@{selectedPack.comboPackChannelsInfo.footerVerbiageFirst}"
                        android:textColor="@color/tint_purple_25"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/combo_selected_pack_card"
                        tools:text="Subscription amount will be deducted from your Tata sky balance every 30 days" />

                    <TextView
                        android:id="@+id/tv_combo_sub_footer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10"
                        android:gravity="center"
                        android:text="@{selectedPack.comboPackChannelsInfo.footerVerbiageSecond}"
                        android:textColor="@color/tint_purple_25"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_combo_footer"
                        tools:text="Please visit tataplay.com to make any changes to the plan." />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_normal_plan_root"
                    android:layout_width="@dimen/dimen_0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:paddingHorizontal="@dimen/my_plan_margin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible"
                    >

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_h_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.9" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_v_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_begin="0dp" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_v_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="1" />


                    <TextView
                        android:id="@+id/tv_sub_landing_title"
                        style="@style/TSTextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="4sp"
                        android:text="@string/my_plan"
                        android:textSize="@dimen/text_size_28"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <include
                        android:id="@+id/selected_pack_card"
                        layout="@layout/layout_freemium_current_pack_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/view_margin_xlarge"
                        app:layout_constraintEnd_toEndOf="@id/guideline_v_2"
                        app:layout_constraintStart_toStartOf="@id/guideline_v_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_sub_landing_title"
                        app:pack="@{selectedPack}"
                        app:regionalAppInfo="@{regionalAppInfo}"/>
                    <TextView
                        android:id="@+id/tv_fiber_verbiage"
                        style="@style/TSTextDefault"
                        android:fontFamily="@font/volteplay_medium"
                        android:text=""
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/view_margin_medium"
                        android:layout_marginTop="@dimen/dimens_15dp"
                        android:layout_marginEnd="@dimen/view_margin_medium"
                        android:layout_marginBottom="@dimen/view_margin_large"
                        android:gravity="center"
                        android:visibility="gone"
                        android:lineSpacingExtra="2sp"
                        android:textColor="?colorOnSecondary"
                        android:textSize="@dimen/text_size_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/selected_pack_card"
                        app:layout_constraintVertical_bias="0" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_change_plan"
                        style="@style/PackCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/view_margin_small"
                        android:visibility="gone"
                        app:cardCornerRadius="@dimen/view_margin_medium"
                        app:layout_constraintWidth_max="@dimen/subscription_tab_max_width"
                        app:layout_constraintEnd_toEndOf="@id/guideline_v_2"
                        app:layout_constraintStart_toStartOf="@id/guideline_v_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_fiber_verbiage"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/view_margin_smallest">

                            <ImageView
                                android:id="@+id/img_crown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/view_margin_medium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/crown_with_bg" />

                            <TextView
                                android:id="@+id/tv_change_plan"
                                style="@style/TSTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{!TextUtils.isEmpty(selectedPack.planCTADetails.changePlanText) ? selectedPack.planCTADetails.changePlanText : @string/change_plan, default=@string/change_plan}"
                                android:textSize="@dimen/text_size_16"
                                android:textColor="@color/pack_text_color"
                                app:layout_constraintBottom_toTopOf="@id/tv_change_plan_text"
                                app:layout_constraintStart_toEndOf="@id/img_crown"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/tv_change_plan_text"
                                style="@style/TSTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingBottom="@dimen/view_margin_smallest"
                                android:text="Get more apps with more savings"
                                android:textColor="?colorOnSecondary"
                                android:textSize="@dimen/text_size_14"
                                android:visibility="gone"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/img_arrow"
                                app:layout_constraintHorizontal_bias="0"
                                app:layout_constraintStart_toEndOf="@id/img_crown"
                                app:layout_constraintTop_toBottomOf="@id/tv_change_plan" />

                            <ImageView
                                android:id="@+id/img_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/view_margin_medium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_arrow_right"

                                app:tint="?colorPrimary" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_change_tenure"
                        style="@style/PackCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/view_margin_small"
                        android:visibility="gone"
                        app:layout_constraintWidth_max="@dimen/subscription_tab_max_width"
                        app:cardCornerRadius="@dimen/view_margin_medium"
                        app:layout_constraintEnd_toEndOf="@id/guideline_v_2"
                        app:layout_constraintStart_toStartOf="@id/guideline_v_1"
                        app:layout_constraintTop_toBottomOf="@id/card_change_plan"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/view_margin_smallest">

                            <ImageView
                                android:id="@+id/img_tenure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/view_margin_medium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_tenure_year" />

                            <TextView
                                android:id="@+id/tv_change_tenure"
                                style="@style/TSTextDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{!TextUtils.isEmpty(selectedPack.planCTADetails.changeTenureText) ? selectedPack.planCTADetails.changeTenureText : @string/change_tenure, default=@string/change_tenure}"
                                android:textSize="@dimen/text_size_16"
                                android:textColor="@color/pack_text_color"
                                app:layout_constraintBottom_toTopOf="@id/tv_change_tenure_plan"
                                app:layout_constraintStart_toEndOf="@id/img_tenure"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/tv_change_tenure_plan"
                                style="@style/TSTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Standard VIP"
                                android:textColor="?colorOnSecondary"
                                android:textSize="@dimen/text_size_14"
                                android:visibility="gone"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/tv_tenure_price_strike_off"
                                app:layout_constraintHorizontal_bias="0"
                                app:layout_constraintStart_toEndOf="@id/img_tenure"
                                app:layout_constraintTop_toBottomOf="@id/tv_change_tenure" />

                            <TextView
                                android:id="@+id/tv_tenure_price_strike_off"
                                style="@style/TSTextDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/view_margin_small"
                                android:paddingTop="@dimen/view_margin_small"
                                android:text="@{String.format(@string/rupees, 1699)}"
                                android:textColor="?colorOnSecondary"
                                android:visibility="gone"
                                app:layout_constraintEnd_toStartOf="@id/tv_tenure_price"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strikeThrough="@{true}"
                                tools:text="₹ 1699" />

                            <TextView
                                android:id="@+id/tv_tenure_price"
                                style="@style/TSTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(@string/rupees, 1699)}"
                                android:visibility="gone"
                                app:layout_constraintBottom_toTopOf="@id/tv_plan_tenure"
                                app:layout_constraintEnd_toStartOf="@id/img_arrow_1"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"
                                tools:text="₹ 1699" />

                            <TextView
                                android:id="@+id/tv_plan_tenure"
                                style="@style/TSTextDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 Year"
                                android:textColor="?colorOnSecondary"
                                android:textSize="@dimen/text_size_14"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/img_arrow_1"
                                app:layout_constraintTop_toBottomOf="@id/tv_tenure_price" />


                            <ImageView
                                android:id="@+id/img_arrow_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/view_margin_medium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_arrow_right"
                                app:tint="?colorPrimary" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier_prime"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:orientation="horizontal"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="cl_normal_plan_root,cl_combo_plan_root" />


                <View
                    android:id="@+id/divider_addon_start"
                    android:layout_width="0dp"
                    android:layout_height="1px"
                    android:layout_marginStart="30dp"
                    android:background="@color/stroke_color"
                    android:visibility="@{primeVisible?View.VISIBLE:View.GONE, default=gone}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_add_on"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_on"
                    app:layout_constraintHorizontal_weight=".1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_add_on"
                    tools:visibility="visible"

                    />

                <TextView
                    android:id="@+id/tv_add_on"
                    style="@style/TSTextMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_large"
                    android:gravity="center"
                    android:text="@string/add_on"
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/white"
                    android:visibility="@{primeVisible?View.VISIBLE:View.GONE, default=gone}"
                    app:layout_constraintEnd_toStartOf="@id/divider_addon_end"
                    app:layout_constraintHorizontal_weight=".1"
                    app:layout_constraintStart_toEndOf="@id/divider_addon_start"
                    app:layout_constraintTop_toBottomOf="@id/barrier_prime"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/divider_addon_end"
                    android:layout_width="0dp"
                    android:layout_height="1px"
                    android:layout_marginEnd="30dp"
                    android:background="@color/stroke_color"
                    android:visibility="@{primeVisible?View.VISIBLE:View.GONE, default=gone}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_add_on"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight=".1"
                    app:layout_constraintStart_toEndOf="@id/tv_add_on"
                    app:layout_constraintTop_toTopOf="@id/tv_add_on"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/amazon_packs"
                    layout="@layout/layout_amazon_pack_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/my_plan_margin"
                    android:layout_marginTop="@dimen/view_margin_large"
                    app:isVisible="@{primeVisible}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_add_on" />


                <TextView
                    android:id="@+id/tv_msg"
                    style="@style/TSTextDefault"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/view_margin_medium"
                    android:layout_marginTop="300dp"
                    android:layout_marginEnd="@dimen/view_margin_medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2sp"
                    android:textColor="?colorOnSecondary"
                    android:textSize="@dimen/text_size_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/amazon_packs" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</layout>
