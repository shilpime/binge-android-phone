<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.tatasky.binge.ui.features.myaccount.MyAccountViewModel" />
        <variable
            name="model"
            type="com.tatasky.binge.data.networking.models.response.LoginResponse.BingeSubscription" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"
        tools:visibility="visible">

        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/shadowed_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/tab_padding"
                android:layout_marginEnd="@dimen/tab_padding_right">

                <TextView
                    android:id="@+id/textView"
                    style="@style/TSText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_account"
                    android:textSize="@dimen/tab_toolbar_text"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TSTextBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.getVerbiageFromConfig().header}"
                    android:layout_marginTop="@dimen/tab_top_margin_device_managment_primaryText"
                    android:textSize="@dimen/text_size_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView" />

                <TextView
                    android:id="@+id/subID_TV"
                    style="@style/TSTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_large"
                    android:textSize="@dimen/dimen_8sp"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    tools:text="Sub ID: 0123456789"
                    android:text="@{viewModel.splitSubID().get(0) + viewModel.sharedPrefs.getOriginalSubscriberId()}"/>

                <TextView
                    android:id="@+id/tv_multiple"
                    style="@style/TSTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tab_margin20_top"
                    android:text="@{viewModel.splitSubID().get(1)}"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintTop_toBottomOf="@id/subID_TV" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    setAdapter="@{viewModel.getSelectBAIDAdapter()}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tab_margin10_20_top"
                    app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_multiple" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.AppTheme.ButtonStyle.Icon"
                    android:enabled="true"
                    android:text="@{viewModel.getVerbiageFromConfig().cta}"
                    android:visibility="gone"
                    android:layout_marginTop="20dp"
                    app:layout_constraintBottom_toTopOf="@id/guideline_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recycler_view"
                    app:layout_constraintVertical_bias="0.0"
                    tools:visibility="visible" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_end="@dimen/dimens_20dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
