<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_tab_popup_bg"
    android:paddingTop="@dimen/view_margin_large"
    app:layout_constraintWidth_max="@dimen/tab_popup_max_width"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    android:paddingBottom="@dimen/view_margin_large">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideLine_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/view_margin_xxlarge" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideLine_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/view_margin_xxlarge" />


    <ImageView
        android:id="@+id/user_logo"
        android:layout_marginTop="@dimen/dp_30"
        app:srcCompat="@drawable/ic_user_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/tv_dialog_title"
        style="@style/TSTextBold"
        android:layout_width="@dimen/margin_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:gravity="center"
        tools:text="@string/profile_pic_alert"
        android:textSize="@dimen/text_size_22"
        app:layout_constraintEnd_toEndOf="@id/guideLine_end"
        app:layout_constraintStart_toStartOf="@id/guideLine_start"
        app:layout_constraintTop_toBottomOf="@id/user_logo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_primary"
        style="@style/Widget.AppTheme.ButtonStyle.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_margin_xxlarge"
        android:layout_marginBottom="@dimen/view_margin_medium"
        android:gravity="center"
        tools:text="@string/capture_new"
        app:layout_constraintBottom_toTopOf="@id/btn_dialog_secondary"
        app:layout_constraintEnd_toEndOf="@id/guideLine_end"
        app:layout_constraintStart_toStartOf="@id/guideLine_start"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_secondary"
        style="@style/Widget.AppTheme.ButtonStyle.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_margin_small"
        android:gravity="center"
        tools:text="@string/from_gallery"
        app:layout_constraintEnd_toEndOf="@id/guideLine_end"
        app:layout_constraintStart_toStartOf="@id/guideLine_start"
        app:layout_constraintTop_toBottomOf="@id/btn_dialog_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_remove"
        style="@style/Widget.AppTheme.ButtonStyle.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_margin_small"
        android:gravity="center"
        tools:text="@string/remove_profile_pic"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/guideLine_end"
        app:layout_constraintStart_toStartOf="@id/guideLine_start"
        app:layout_constraintTop_toBottomOf="@id/btn_dialog_secondary" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/Widget.AppTheme.ButtonStyle.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_margin_small"
        android:gravity="center"
        tools:text="@string/close"
        android:visibility="visible"
        app:layout_goneMarginTop="@dimen/dp_30"
        app:layout_constraintEnd_toEndOf="@id/guideLine_end"
        app:layout_constraintStart_toStartOf="@id/guideLine_start"
        app:layout_constraintTop_toBottomOf="@id/btn_remove" />
</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
