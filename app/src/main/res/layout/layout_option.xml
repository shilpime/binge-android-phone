<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="offerEligible"
            type="com.tatasky.binge.data.networking.models.response.OfferEligiblePacks" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bundle_divider"
        android:paddingTop="@dimen/view_margin_medium">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_isAvailable"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{offerEligible.value}"
                android:textSize="@dimen/text_size_16"
                android:visibility='@{(offerEligible.value.equals("YES") || offerEligible.value.equals("NO")) ? View.GONE : View.VISIBLE, default=visible}'
                app:layout_constraintBottom_toBottomOf="@id/barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_isAvailable"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src='@{offerEligible.value.equals("YES") ? @drawable/ic_tick_available:@drawable/ic_cross}'
                android:visibility='@{(offerEligible.value.equals("YES") || offerEligible.value.equals("NO"))? View.VISIBLE : View.GONE, default=gone}'
                app:layout_constraintBottom_toBottomOf="@id/barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="iv_isAvailable,tv_isAvailable" />

            <TextView
                android:id="@+id/tv_option"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_smallest"
                android:gravity="center"
                android:paddingStart="@dimen/view_margin_medium"
                android:paddingEnd="@dimen/view_margin_medium"
                android:textSize="@dimen/text_size_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrier" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>