<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/rail_margins"
            android:layout_marginBottom="@dimen/view_margin_medium"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rail_title"
                style="@style/TSTextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/view_margin_medium"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/trending"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_2"
                android:layout_below="@id/rail_title"
                android:layout_marginStart="@dimen/view_margin_medium"
                android:layout_marginEnd="@dimen/view_margin_medium"
                android:contentDescription="@string/sample_iv_desc"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/ic_divider"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/llTitle"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="@dimen/view_margin_medium"
            android:orientation="vertical"
            app:reverseLayout="false"/>
    </RelativeLayout>
</layout>