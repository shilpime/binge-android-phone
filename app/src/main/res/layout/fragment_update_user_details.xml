<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="loginDTO"
            type="com.tatasky.binge.data.networking.models.requests.LoginDTO" />

        <import type="android.text.InputType" />
        <import type="android.text.TextUtils"/>
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/view_margin_xxlarge"
        android:layout_marginEnd="@dimen/view_margin_xxlarge"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_tbaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/sample_iv_desc"
                app:srcCompat="@drawable/medium_binge_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guideline_2"
                app:layout_constraintVertical_bias="1" />

            <com.tatasky.binge.customviews.PageIndicatorView
                android:id="@+id/ll_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_tbaa"
                app:selected_page="3"
                app:total_pages="4" />


            <TextView
                android:id="@+id/tv_update_details"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/view_margin_large"
                android:layout_marginBottom="@dimen/view_margin_xxlarge"
                android:text="@{!TextUtils.isEmpty(loginDTO.email)?@string/confirm_email:@string/update_email}"
                android:textSize="@dimen/text_size_28"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_page_indicator" />

            <include
                android:id="@+id/et_name"
                layout="@layout/layout_uneditabletextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_large"
                app:etValue="@{loginDTO.name}"
                app:headerText="@{@string/name}"
                app:hint="@{@string/name_hint}"
                app:inputType="@{InputType.TYPE_CLASS_TEXT}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/tv_update_details"
                app:maxLength="@{20}"
                app:maxLines="@{1}" />

            <include
                android:id="@+id/et_mobile"
                layout="@layout/layout_uneditabletextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_medium"
                app:etValue="@{String.format(@string/mobile_template,loginDTO.rmn)}"
                app:headerText="@{@string/registered_mobile_number}"
                app:hint="@{@string/mobile_hint}"
                app:inputType="@{InputType.TYPE_CLASS_NUMBER}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/et_name"
                app:maxLines="@{1}" />

            <include
                android:id="@+id/et_email"
                layout="@layout/layout_edittextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_medium"
                app:etValue="@{loginDTO.email}"
                app:headerText="@{@string/email_id_title}"
                app:required="@{true}"
                app:hint="@{@string/email_hint}"
                app:inputType="@{InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/et_mobile"
                app:maxLength="@{50}"
                app:maxLines="@{1}" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProceed"
                android:layout_width="match_parent"
                android:enabled="false"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="@dimen/margin_64"
                android:text="@{!TextUtils.isEmpty(loginDTO.email)?@string/confirm:@string/update}"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent=".01" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
