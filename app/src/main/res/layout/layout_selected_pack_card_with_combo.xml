<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="proRataValue"
            type="Integer" />

        <import type="android.view.View" />

        <import type="com.tatasky.binge.utils.SubscriptionPackStatusEnum" />

        <import type="android.text.TextUtils" />

        <variable
            name="pack"
            type="com.tatasky.binge.data.networking.models.response.PartnerPacks" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_heading"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/view_margin_medium"
            android:text="@{pack.verbiage.subsTitle}"
            android:textColor="@color/offer_color"
            android:visibility="@{pack.subscriptionDetailInfo.bingeAccountStatus.equalsIgnoreCase(SubscriptionPackStatusEnum.ACTIVE.status)?View.VISIBLE:View.GONE, default=visible}"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="You are currently enjoying access to 12 entertainment apps at one place!" />

        <TextView
            android:id="@+id/tv_pack_name"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_large"
            android:layout_marginEnd="@dimen/view_margin_large"
            android:gravity="start"
            android:text="@{pack.packName}"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintEnd_toStartOf="@id/tv_pack_price"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_heading" />

        <TextView
            android:id="@+id/tv_pack_price"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{String.format(@string/rupees_cyclic, pack.formattedPrice, pack.renewalCycle.toLowerCase())}"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_pack_name"
            tools:text="299 per month"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_renewal_cycle"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_smallest"
            android:textColor="@color/offer_color"
            android:textSize="@dimen/text_size_12"
            android:visibility="@{pack.subscriptionDetailInfo.migrated?View.VISIBLE:View.GONE, default=visible}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_pack_name"
            app:layout_constraintTop_toBottomOf="@id/tv_pack_name"
            tools:text="Expires on 20/12/2021" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_renewal_cycle"
            app:layout_constraintTop_toTopOf="@id/tv_tag" />


        <com.tatasky.binge.customviews.CustomMaterialCardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_medium"
            app:layout_constraintTop_toBottomOf="@id/tv_renewal_cycle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/view_margin_large"
                android:paddingTop="@dimen/view_margin_small"
                android:paddingBottom="@dimen/view_margin_small">

                <TextView
                    android:id="@+id/tv_total_apps"
                    style="@style/TSTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{pack.verbiage.appsGridHeader}"
                    android:textSize="@dimen/text_size_18"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_packs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_small"
                    android:overScrollMode="never"
                    app:layoutManager="com.tatasky.binge.customviews.RVGridLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_total_apps"
                    app:spanCount="4" />

                <TextView
                    android:id="@+id/tv_pack_disclaimer"
                    style="@style/TSTextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_smallest"
                    android:text="@{pack.extraInfo}"
                    android:textColor="@color/offer_color"
                    android:textSize="10sp"
                    android:visibility="@{!TextUtils.isEmpty(pack.extraInfo)? View.VISIBLE : View.GONE , default=gone}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recycler_packs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_modify_subscription"
                    style="@style/Widget.AppTheme.ButtonStyle.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:minHeight="@dimen/margin_0"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_pack_disclaimer"
                    app:text="@{(pack.cancelled==true &amp;&amp; pack.subscriptionDetailInfo.bingeAccountStatus.equalsIgnoreCase(SubscriptionPackStatusEnum.ACTIVE.status))?@string/revoke_cancellation:@string/modify_subscription}"
                    app:underlined="@{true}" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.tatasky.binge.customviews.CustomMaterialCardView>

        <TextView
            android:id="@+id/tv_tag"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pack_tag_background"
            android:elevation="@dimen/view_margin_smallest"
            android:paddingStart="@dimen/view_margin_small"
            android:paddingTop="@dimen/view_margin_smallest"
            android:paddingEnd="@dimen/view_margin_small"
            android:paddingBottom="@dimen/view_margin_smallest"
            android:textSize="@dimen/text_size_12"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/cardView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardView"
            tools:text="Expired"
            tools:visibility="visible" />


        <TextView
            android:id="@+id/tv_eligibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_medium"
            android:gravity="center"
            android:textColor="@color/offer_color"
            android:textSize="@dimen/text_size_14"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardView" />

        <ImageView
            android:id="@+id/iv_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_medium"
            android:minWidth="@dimen/margin_24"
            android:visibility="@{pack.isCombo &amp;&amp; pack.comboPackChannelsInfo != null ? View.VISIBLE:View.GONE, default=gone}"
            android:minHeight="@dimen/margin_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_eligibility"
            app:srcCompat="@drawable/ic_plus"
            tools:visibility="visible" />

        <com.tatasky.binge.customviews.CustomMaterialCardView
            android:id="@+id/cardView_combo_channel_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:visibility="visible"
            android:visibility="@{pack.isCombo &amp;&amp; pack.comboPackChannelsInfo != null ? View.VISIBLE:View.GONE, default=gone}"
            android:layout_marginTop="@dimen/view_margin_medium"
            android:layout_marginBottom="@dimen/view_margin_medium"
            app:layout_constraintTop_toBottomOf="@id/iv_plus">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/view_margin_large"
                android:paddingTop="@dimen/view_margin_large"
                android:paddingBottom="@dimen/view_margin_large">

                <TextView
                    android:id="@+id/tv_total_channels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="145 TV Channels"
                    android:text="@{pack.comboPackChannelsInfo.ottChannelsVerbiage}"
                    style="@style/TSTextMedium"
                    android:textSize="@dimen/text_size_18"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_channels"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_default="wrap"
                    android:layout_height="wrap_content"
                    tools:itemCount="1"
                    app:layout_constraintBaseline_toBaselineOf="@id/tv_total_channels"
                    android:layout_marginStart="@dimen/view_margin_xxlarge"
                    app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toEndOf="@id/tv_total_channels"
                    app:layout_constraintTop_toTopOf="@id/tv_total_channels"
                    app:reverseLayout="false" />

                <TextView
                    android:id="@+id/tv_channels_info"
                    style="@style/TSTextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_small"
                    android:textColor="@color/offer_color"
                    android:text="@{pack.comboPackChannelsInfo.verbiage}"
                    tools:text="Channels are available for viewing on TV with your Tata Play Set Top Box "
                    android:textSize="@dimen/text_size_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_total_channels" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.tatasky.binge.customviews.CustomMaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>