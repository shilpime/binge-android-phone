<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="title" type="String"/>
        <variable name="isChecked" type="Boolean"/>
    </data>
    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <TextView android:id="@+id/tv_notification_switch"
                  style="@style/TSTextMedium"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_alignParentStart="true"
                  android:layout_centerVertical="true"
                  android:layout_toStartOf="@id/sw_notification"
                  android:text="@{title}"
                  android:textSize="@dimen/text_size_16"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_notification"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/switch_height"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/view_margin_large"
                android:checked="@{isChecked}"/>
    </RelativeLayout>
</layout>