<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <variable name="contentItem" type="com.tatasky.binge.data.networking.models.response.ContentItem"/>
    </data>
    <com.tatasky.binge.customviews.SquareLayout
        android:id="@+id/cardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/semi_transparent">
        <ImageView
            android:id="@+id/img"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"
            android:contentDescription="@string/sample_iv_desc"/>
        <ImageView
            android:id="@+id/imgCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_margin="8dp"
            app:srcCompat="@drawable/ic_tick_login_success"
            />
    </com.tatasky.binge.customviews.SquareLayout>


</layout>