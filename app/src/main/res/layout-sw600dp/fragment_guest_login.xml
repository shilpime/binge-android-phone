<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.tatasky.binge.ui.features.onboarding.login.bottomsheet.GuestLoginViewModel" />
        <import type="android.view.View"/>
        <import type="android.text.InputType" />
    </data>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/tab_popup_max_width"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_tab_popup_bg"
        tools:context=".ui.features.onboarding.login.bottomsheet.GuestLoginFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_margin_start"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="38dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_margin_end"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_end="38dp" />

        <include
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/header"
            layout="@layout/layout_header_guest_login"
            android:visibility="visible"
            bind:isEligibleForFreeTrial="@{viewModel.showFreeTrailUI}"
            bind:headerTitle="@{viewModel.getVerbiageFromConfig().loginScreen.login}"
            bind:partnerLogoRVAdapter="@{viewModel.getPartnerLogoAdapter}"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/rmn_Group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="et_mobile_guest_login, licenseAgreement_TV, btn_proceed_guest_login, btn_cancel_guest_login"
            android:visibility="visible"/>

        <include
            android:id="@+id/et_mobile_guest_login"
            layout="@layout/layout_mobile_edittextbox_guest_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintWidth_max="@dimen/login_et_max_width"
            android:layout_marginEnd="2dp"
            app:headerText="@{@string/enter_mobile_text_guest_login}"
            app:hint="@{!viewModel.showFreeTrailUI ? @string/hint_enter_mobile_text_guest_login : @string/enter_mobile_text_guest_login}"
            app:inputType="@{InputType.TYPE_CLASS_NUMBER}"
            app:isVisible="@{true}"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:maxLength="@{15}"
            app:maxLines="@{1}"/>

        <TextView
            android:id="@+id/licenseAgreement_TV"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_14"
            android:lineSpacingExtra="2sp"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_mobile_guest_login"
            android:layout_marginTop="@dimen/margin_10"
            tools:text="@string/license_agreement"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proceed_guest_login"
            android:layout_width="280dp"
            android:layout_height="@dimen/dimen_46dp"
            android:insetTop="@dimen/dimen_0dp"
            android:insetBottom="@dimen/dimen_0dp"
            android:layout_marginBottom="@dimen/dimens_8dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="@dimen/margin_24"
            android:enabled="false"
            android:text="@{!viewModel.showFreeTrailUI ? viewModel.setVerbiageForLoginScreen().cta : viewModel.setVerbiageForLoginScreen().getOtp, default = @string/get_otp}"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/licenseAgreement_TV"
            app:layout_constraintBottom_toTopOf="@id/btn_cancel_guest_login"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_guest_login"
            style="@style/Widget.AppTheme.ButtonStyle.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/view_margin_medium"
            android:text="@string/text_not_now"
            android:textSize="@dimen/text_size_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_margin_end"
            app:layout_constraintStart_toEndOf="@id/guideline_margin_start"
            app:layout_constraintTop_toBottomOf="@id/btn_proceed_guest_login"/>

        <include
            android:id="@+id/layoutLoginOTP"
            layout="@layout/layout_guest_login_otp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            tools:layout_marginTop="@dimen/dimens_24dp"
            android:visibility="gone"
            bind:isEligibleForFreeTrial="@{viewModel.showFreeTrailUI}"
            bind:resendOtp="@{viewModel.setVerbiageForLoginScreen().resendOtp}"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
