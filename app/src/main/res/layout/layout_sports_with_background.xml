<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="railsModel"
            type="com.tatasky.binge.ui.features.home.model.RailsModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/rail_margins">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_bg_sports"
            android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardCornerRadius="@dimen/dimens_5dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_bg_sports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:src="@drawable/game_item_sample"
                android:scaleType="fitXY" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_overlay_sports_card"
                android:elevation="5dp"
                tools:visibility="visible"/>
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/iv_provider_logo"
            android:layout_width="wrap_content"
            android:scaleType="fitStart"
            app:layout_constraintWidth_min="130dp"
            tools:src="@drawable/logo_tatasky_details"
            android:layout_height="25dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="5dp"
            android:elevation="@dimen/dp_10"
            android:layout_marginTop="84dp"
            tools:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/cv_bg_sports" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sports_rail"
            setAdapter="@{railsModel.adapter}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/dp_6"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:lineSpacingExtra="4dp"
            android:orientation="horizontal"
            tools:listitem="@layout/layout_rail_item_temp"
            android:elevation="@dimen/dp_10"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/iv_provider_logo"
            app:layout_constraintEnd_toEndOf="@id/cv_bg_sports"
            app:layout_constraintStart_toStartOf="@id/cv_bg_sports" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
