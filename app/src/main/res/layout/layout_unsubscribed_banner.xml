<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable name="contentItem" type="com.tatasky.binge.data.networking.models.response.HomeResponse.Items"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/partner_unsubscribed_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/view_margin_xxlarge"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/view_margin_xxlarge"/>

        <ImageView
            android:id="@+id/partner_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_0"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/shp_placeholder"
            android:contentDescription="@string/sample_iv_desc"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/subtitle"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/view_margin_xxlarge"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            android:text="@{contentItem.unsubscribedTitle}"
            android:textColor="?colorOnSecondary"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/partner_banner"
            app:layout_constraintStart_toEndOf="@id/guideline_start"
            tools:text="2015 | Comedy, Drama | 121m"/>
        <TextView
            android:id="@+id/partner_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/view_margin_large"
            android:visibility="gone"
            android:textSize="@dimen/text_size_16"
            style="@style/TSTextMedium"
            android:text="@{contentItem.description}"
            app:layout_constraintEnd_toStartOf="@id/guideline_end"
            app:layout_constraintStart_toEndOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            tools:text="Netflix is a streaming service that offers a wide variety of award-winning TV shows, movies, anime, documentaries and more."/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_activate_partner"
            android:layout_width="@dimen/margin_0"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/view_margin_large"
            android:text="@string/subscribe_to_get_this_App"
            app:layout_constraintEnd_toStartOf="@id/guideline_end"
            app:layout_constraintStart_toEndOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/partner_description"/>

        <androidx.legacy.widget.Space
            android:layout_width="match_parent"
            android:layout_height="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn_activate_partner"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>