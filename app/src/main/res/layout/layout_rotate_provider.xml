<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlParent"
        android:layout_width="match_parent"
        android:layout_marginEnd="@dimen/view_margin_medium"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_10"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/sample_iv_desc"
            app:shapeAppearanceOverlay="@style/customRoundedLogo"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_hotstar_logo" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
