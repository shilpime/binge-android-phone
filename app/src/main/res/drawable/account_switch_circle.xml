<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <rotate android:fromDegrees="40">
            <shape android:shape="oval">
                <solid
                    android:color="?colorPrimary"/>
                <!--
                            <gradient
                                android:angle="180"
                                android:centerColor="@color/color_expiring_red"
                                android:endColor="@color/color_orange"
                                android:startColor="@color/color_blue" />-->
                <padding
                    android:bottom="@dimen/margin_2"
                    android:left="@dimen/margin_2"
                    android:right="@dimen/margin_2"
                    android:top="@dimen/margin_2" />
            </shape>
        </rotate>
    </item>

    <item android:id="@android:id/background">
        <shape android:shape="oval">
            <solid android:color="?android:colorPrimaryDark" />
        </shape>
    </item>

</layer-list>