<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable name="viewModel" type="com.tatasky.binge.ui.features.home.subpage.SeeAllViewModel"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar_layout"
            android:layout_width="@dimen/dimen_0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="@dimen/dimens_10dp"
            >
            <include
                layout="@layout/transparent_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </androidx.appcompat.widget.LinearLayoutCompat>



        <ImageView
            android:id="@+id/iv_see_all_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_120dp"
            android:visibility="gone"
            android:scaleType="fitXY"
            android:src="@drawable/compare_plan_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/toolbar_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="toolbar_layout,iv_see_all_banner" />


        <ImageView
            android:id="@+id/progressBarBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/dimens_56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/progress_avd"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subpage_recycler"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_0"
            android:layout_marginStart="@dimen/grid_horizontal_margin"
            android:layout_marginEnd="@dimen/screen_end_margin"
            android:paddingBottom="@dimen/dimens_56dp"
            tools:listitem="@layout/layout_rail_item_temp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/toolbar_barrier"
            app:layout_constraintBottom_toTopOf="@id/progressBarBottom"
            app:spanCount="@integer/grid_landscape"
            setAdapter="@{viewModel.mAdapter}"
            android:orientation="vertical"
            app:layoutManager="com.tatasky.binge.customviews.RVGridLayoutManager"
            app:reverseLayout="false"/>
        <TextView
            android:id="@+id/tvNoData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/no_content_available"
            android:textSize="@dimen/text_size_16"
            android:visibility="gone"
            style="@style/TSTextMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
