<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.tatasky.binge.ui.features.myaccount.MyAccountViewModel" />
        <variable
            name="model"
            type="com.tatasky.binge.data.networking.models.response.LoginResponse.BingeSubscription" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"
        tools:visibility="visible">

        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/shadowed_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/view_margin_xlarge"
                android:layout_marginEnd="@dimen/view_margin_xlarge">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TSTextBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_xlarge"
                    android:text="@string/title_multiple_bs"
                    android:textSize="@dimen/text_size_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/subID_TV"
                    style="@style/TSTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_large"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    tools:text="Sub ID: 0123456789"
                    android:text="@{String.format(@string/tran_history_sub_id, viewModel.sharedPrefs.getOriginalSubscriberId())}"/>

                <TextView
                    android:id="@+id/tv_multiple"
                    style="@style/TSTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_large"
                    android:text="@string/select_one_bs"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintTop_toBottomOf="@id/subID_TV" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    setAdapter="@{viewModel.getSelectBAIDAdapter()}"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
                    app:layout_constraintBottom_toTopOf="@id/btnNext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_multiple" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="@dimen/margin_0"
                    android:layout_height="@dimen/button_height"
                    android:enabled="true"
                    android:text="@string/change"
                    app:layout_constraintBottom_toTopOf="@id/guideline_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_end="@dimen/dimens_20dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>