<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            app:srcCompat="@drawable/maintenance"
            android:id="@+id/iv_development"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/tv_under_development"
            android:layout_centerHorizontal="true"/>

        <TextView android:id="@+id/tv_under_development"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/view_margin_xxlarge"
            android:text="Under Development"
            android:textSize="@dimen/text_size_18"/>
    </RelativeLayout>
</layout>