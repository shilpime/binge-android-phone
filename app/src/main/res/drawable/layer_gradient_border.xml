<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item>
        <shape android:shape="rectangle" >
            <corners android:radius="8dp" />

            <gradient
                android:angle="270"
                android:startColor="#FFF389"
                android:endColor="#FFA800"
                android:type="linear" />
            <size android:width="24dp"
                android:height="24dp"/>
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle" >
            <corners android:radius="8dp" />
            <solid android:color="@color/darkHighlight" />
        </shape>
    </item>

</layer-list>