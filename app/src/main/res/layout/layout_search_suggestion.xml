<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="suggestion" type="com.tatasky.binge.data.networking.models.response.ContentItem"/>
        <variable name="vm" type="com.tatasky.binge.ui.features.search.model.SearchViewModel"/>
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{()->vm.setClickedSuggestion(suggestion)}"
        android:padding="@dimen/view_margin_small">
        <TextView
            android:id="@+id/tvSearchKeyword"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/view_margin_medium"
            htmlText="@{suggestion.title}"
            android:textSize="@dimen/text_size_18"
            app:drawableStartCompat="@drawable/ic_search" />
    </FrameLayout>
</layout>