<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="title"
            type="String"/>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/view_margin_small"
        android:paddingBottom="@dimen/view_margin_small"
        android:visibility="@{title==null?View.GONE:View.VISIBLE}">

        <TextView
            android:id="@+id/filters_title"
            style="@style/TSTextBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{title}"
            android:layout_marginBottom="@dimen/view_margin_small"
            android:visibility="@{title.isEmpty() ? View.GONE : View.VISIBLE}"
            android:textSize="@dimen/text_size_16"
            android:layout_marginStart="@dimen/view_margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Top Movies"/>
        <HorizontalScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="@dimen/dimens_4dp"
            app:layout_constraintTop_toBottomOf="@id/filters_title">
            <RadioGroup
                android:id="@+id/filters_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
        <!--        <androidx.recyclerview.widget.RecyclerView-->
        <!--                android:id="@+id/filters_recycler_view"-->
        <!--                setAdapter="@{railsModel.adapter}"-->
        <!--                android:layout_width="wrap_content"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_marginTop="@dimen/view_margin_small"-->
        <!--                android:background="@android:color/transparent"-->
        <!--                android:clipToPadding="false"-->
        <!--                android:lineSpacingExtra="4dp"-->
        <!--                android:orientation="horizontal"-->
        <!--                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"-->
        <!--                app:layout_constraintStart_toStartOf="parent"-->
        <!--                app:layout_constraintTop_toBottomOf="@id/filters_title"/>-->
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
