<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="proRataValue"
            type="Integer" />

        <import type="android.view.View" />

        <import type="com.tatasky.binge.utils.SubscriptionPackStatusEnum" />

        <import type="android.text.TextUtils"/>

        <variable
            name="pack"
            type="com.tatasky.binge.data.networking.models.response.PartnerPacks" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            android:backgroundTint="@color/transparent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/view_margin_large"
                android:paddingTop="@dimen/view_margin_large"
                android:paddingBottom="@dimen/view_margin_small">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_packs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_medium"
                    android:overScrollMode="never"
                    app:layoutManager="com.tatasky.binge.customviews.RVGridLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:spanCount="4" />

                <TextView
                    android:id="@+id/tv_pack_description"
                    style="@style/TSTextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/view_margin_smallest"
                    android:text="@{pack.extraInfo}"
                    android:textSize="10sp"
                    android:visibility="@{!TextUtils.isEmpty(pack.extraInfo) ? View.VISIBLE : View.GONE}"
                    app:layout_constraintStart_toStartOf="@id/recycler_packs"
                    app:layout_constraintTop_toBottomOf="@id/recycler_packs" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>