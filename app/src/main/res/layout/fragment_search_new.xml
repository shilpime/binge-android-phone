<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.tatasky.binge.ui.features.search.model.SearchViewModel" />

        <import type="android.view.View" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:paddingBottom="56dp"
        android:transitionGroup="true">


        <include
            android:id="@+id/searchView"
            layout="@layout/layout_searchview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:transitionGroup="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_suggestion_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:animateLayoutChanges="true"
            android:transitionGroup="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchView"
            tools:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchSuggestionsRecycler"
                setAdapter="@{vm.mSuggestionAdapter}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:reverseLayout="false"
                tools:itemCount="5"
                tools:listitem="@layout/layout_search_suggestion_item"
                tools:showIn="@layout/fragment_search"
                tools:visibility="visible" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/grid_horizontal_margin"
            android:layout_marginTop="10dp"
            android:animateLayoutChanges="true"
            android:transitionGroup="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchView"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.Group
                android:id="@+id/gp_free_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tv_off_settings_item,tv_on_settings_item,switchView"
                tools:visibility="visible" />


            <TextView
                android:id="@+id/tv_off_settings_item"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/screen_horizontal_margin"
                android:maxLines="1"
                android:text="@{vm.setVerbiageForSearchPage().allContent}"
                android:textColor="@color/binge_blue_10"
                android:textSize="@dimen/text_size_13"
                android:translationY="-10dp"
                app:layout_constraintBaseline_toBaselineOf="@id/switchView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchView"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="0dp"
                android:translationY="-10dp"
                app:layout_constraintStart_toEndOf="@id/tv_off_settings_item"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_on_settings_item"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:maxLines="1"
                android:text="@{vm.setVerbiageForSearchPage().free}"
                android:textSize="@dimen/text_size_13"
                android:translationY="-10dp"
                app:layout_constraintBaseline_toBaselineOf="@id/switchView"
                app:layout_constraintStart_toEndOf="@id/switchView"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/tvShowFilter"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:layout_marginEnd="14dp"
                android:button="@null"
                android:drawableEnd="@drawable/filter_checkbox_drawable"
                android:drawablePadding="@dimen/view_margin_small"
                android:paddingBottom="8dp"
                android:text="@{vm.setVerbiageForSearchPage().filter}"
                android:textColor="@color/more_color"
                android:textSize="@dimen/text_size_14"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvShowFilter">

                <include
                    android:id="@+id/language_filters"
                    layout="@layout/layout_filters"
                    app:title="@{vm.languageFilterTitle}" />

                <include
                    android:id="@+id/genre_filters"
                    layout="@layout/layout_filters"
                    app:title="@{vm.genreFilterTitle}" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchRecyclerView"
                setAdapter="@{vm.getSearchAdapter()}"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_0"
                android:layout_marginTop="@dimen/dimens_10dp"
                android:orientation="vertical"
                app:layoutManager="com.tatasky.binge.customviews.RVGridLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/filters"
                app:reverseLayout="false"
                app:spanCount="2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/landing_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:animateLayoutChanges="true"
            android:transitionGroup="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchView"
            tools:visibility="gone">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                app:elevation="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll">
                    <!--                    tv no results-->

                    <LinearLayout
                        android:id="@+id/tvNoData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_36"
                        android:layout_marginTop="@dimen/view_margin_xxlarge"
                        android:layout_marginEnd="@dimen/margin_36"
                        android:layout_marginBottom="@dimen/view_margin_xxlarge"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/historyRecyclerView"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TSTextMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@{vm.setVerbiageForSearchPage().noResults}"
                            android:textSize="@dimen/no_search_text_size"
                            android:visibility="visible" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="22dp"
                            android:visibility="@{vm.isDeviceTablet() ? View.VISIBLE : View.GONE, default=gone}"
                            tools:visibility="visible"
                            android:src="@drawable/ic_icon_no_result_search" />


                    </LinearLayout>


                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/historySuggestionContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:constraint_referenced_ids="tvRecentSearch,historyRecyclerView"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvRecentSearch"
                        style="@style/TSTextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{vm.setVerbiageForSearchPage().recentSearch}"
                        android:layout_marginStart="@dimen/screen_horizontal_margin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/historyRecyclerView"
                        setAdapter="@{vm.recentSearchAdapter}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/screen_horizontal_margin"
                        android:layout_marginTop="@dimen/view_margin_small"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRecentSearch"
                        tools:itemCount="3"
                        tools:listitem="@layout/layout_search_history"
                        tools:showIn="@layout/fragment_search" />


                    <!--                    landing recycler-->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/searchLandingRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutAnimation="@anim/layout_animation_fade_in"
                        android:orientation="vertical"
                        app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
                        app:layout_collapseMode="pin"
                        app:layout_constraintTop_toBottomOf="@id/tvNoData"
                        app:reverseLayout="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/home_recyclerview"
                        tools:showIn="@layout/fragment_search"
                        tools:visibility="visible" />


                    <TextView
                        android:id="@+id/trending_title"
                        style="@style/TSTextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/screen_horizontal_margin"
                        android:layout_marginTop="@dimen/rail_margins"
                        android:paddingBottom="@dimen/margin_6"
                        android:drawablePadding="@dimen/dimens_6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/trending"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_trending"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/searchLandingRecycler"
                        tools:visibility="visible" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.AppBarLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trendingRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/grid_horizontal_margin"
                android:layout_marginBottom="@dimen/view_margin_medium"
                android:orientation="vertical"
                android:overScrollMode="never"
                app:layoutManager="com.tatasky.binge.customviews.RVGridLayoutManager"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                app:reverseLayout="false"
                app:spanCount="2" />


        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <ImageView
            android:id="@+id/progressBarBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:paddingTop="@dimen/view_margin_smallest"
            android:paddingBottom="@dimen/view_margin_large"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/progress_avd"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
