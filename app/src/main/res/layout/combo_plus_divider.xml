<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/combo_divider_1"
        android:layout_width="0dp"
        android:layout_height="2px"
        android:background="@color/stroke_color"
        app:layout_constraintBottom_toBottomOf="@id/iv_combo_divider"
        app:layout_constraintEnd_toStartOf="@id/iv_combo_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_combo_divider" />


    <ImageView
        android:id="@+id/iv_combo_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_12"
        android:layout_marginEnd="@dimen/margin_12"
        app:layout_constraintEnd_toStartOf="@id/combo_divider_2"
        app:layout_constraintStart_toEndOf="@id/combo_divider_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/ic_combo_plus"
        app:tint="@color/stroke_color"/>

    <View
        android:id="@+id/combo_divider_2"
        android:layout_width="0dp"
        android:layout_height="2px"
        android:background="@color/stroke_color"
        app:layout_constraintBottom_toBottomOf="@id/iv_combo_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_combo_divider"
        app:layout_constraintTop_toTopOf="@id/iv_combo_divider" />

</androidx.constraintlayout.widget.ConstraintLayout>