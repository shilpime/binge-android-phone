<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="verbiagesDetails"
            type="com.tatasky.binge.data.networking.models.response.ConfigResponse.FreeTrialStartupNudge" />
    </data>

    <com.tatasky.binge.customviews.CustomMaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_15"
        android:layout_marginEnd="@dimen/margin_15"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginBottom="@dimen/margin_4"
        android:elevation="@dimen/card_elevation_8"
        app:cardCornerRadius="@dimen/corner_radius_16"
        app:strokeColor="@color/stroke_color"
        app:strokeWidth="@dimen/mtrl_textinput_box_stroke_width_focused">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clStartFreeTrialRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/margin_15"
            android:paddingBottom="@dimen/dp_15">

            <TextView
                android:id="@+id/ftTitleTextView"
                style="@style/TSTextMedium"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/line_spacing_4"
                android:text="@{verbiagesDetails.title}"
                android:textAlignment="center"
                android:textSize="@dimen/text_size_18"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/margin_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/ftDescTextView"
                style="@style/TSTextMedium"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_12"
                android:lineSpacingExtra="@dimen/line_spacing_6"
                android:text="@{verbiagesDetails.desc}"
                android:textAlignment="center"
                android:textSize="@dimen/text_size_17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ftTitleTextView" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/trial_btn_proceed"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/padding_10dp"
                android:paddingStart="@dimen/margin_32"
                android:paddingEnd="@dimen/margin_32"
                android:text="@{verbiagesDetails.button}"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ftDescTextView"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.tatasky.binge.customviews.CustomMaterialCardView>
</layout>