<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.tatasky.binge.ui.features.onboarding.login.bottomsheet.GuestLoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/tab_popup_max_width"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_tab_popup_bg"
        tools:context=".ui.features.onboarding.login.bottomsheet.UsedRMNListingFragment">






        <include
            android:id="@+id/header"
            layout="@layout/layout_header_guest_login"
            bind:headerTitle="@{viewModel.sharedPrefs.getConfigResponse().data.config.freeTrialTitle}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <com.tatasky.binge.customviews.CustomRecyclerView
            android:id="@+id/rv_guest_login_previously_used_mobile"
            setAdapter="@{viewModel.guestLoginPreviouslyUsedMobileAdapter}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layoutManager="com.tatasky.binge.customviews.RVLinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            tools:itemCount="4"
            tools:listitem="@layout/layout_previously_used_mobile_item" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proceed_guest_login_previously_used_mobile"
            android:layout_width="280dp"
            android:layout_height="@dimen/dimen_46dp"
            android:insetTop="@dimen/dimen_0dp"
            android:insetBottom="@dimen/dimen_0dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginBottom="@dimen/dimens_8dp"
            android:enabled="true"
            android:text="@string/proceed_to_login"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintBottom_toTopOf="@id/newLogin_Btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_guest_login_previously_used_mobile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newLogin_Btn"
            style="@style/Widget.AppTheme.ButtonStyle.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/view_margin_medium"
            android:text="@string/login_using_new_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>