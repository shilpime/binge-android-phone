<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_details"
    app:startDestination="@id/ttnDetailsFragment">
    <fragment
        android:id="@+id/hungamaDetailsFragment"
        android:name="com.tatasky.binge.ui.features.player.HungamaPlayerFragment"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
    </fragment>
    <fragment
        android:id="@+id/ttnDetailsFragment"
        android:name="com.tatasky.binge.ui.features.ttnplayer.TTNPlayerFragment"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
    </fragment>
    <fragment
        android:id="@+id/erosnowDetailsFragment"
        android:name="com.tatasky.binge.ui.features.player.ErosnowPlayerFragment"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
    </fragment>
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.tatasky.binge.ui.features.details.DetailsFragment"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
        <argument
            android:name="playEpisode"
            app:argType="boolean"
            android:defaultValue="false"
            />
    </fragment>

    <include app:graph="@navigation/nav_nested_seeall"/>
    <action
        android:id="@+id/action_to_detail"
        app:destination="@id/nav_details">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
    </action>
    <action
        android:id="@+id/action_to_detail1"
        app:popUpTo="@+id/nav_details"
        app:popUpToInclusive="true"
        app:destination="@id/nav_details">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
        <argument android:name="fromGrid"
            app:argType="boolean"
            android:defaultValue="false"/>
        <argument
            android:name="playEpisode"
            app:argType="boolean"
            android:defaultValue="false"
            />
    </action>
    <action
        android:id="@+id/action_detailsFragment_to_seeAllFragment"
        app:destination="@id/nav_nested_seeall" >
        <argument
            android:name="railId"
            app:argType="string" />
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="sectionType"
            android:defaultValue="EDITORIAL"
            app:argType="string" />
        <argument
            android:name="isRecommendation"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="detailType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="provider"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="placeHolder"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="source"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="origin"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isMixedRail"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="isPrepand"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="taContentResponse"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.RecommendationResponse"
            app:nullable="true" />
        <argument
            android:name="backgroundImage"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="layoutType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="railPosition"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </action>
    <activity android:id="@+id/prime_activity"
        android:name="com.tatasky.binge.ui.features.prime.view.PrimeActivity">
        <argument
            android:name="contentItem"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="true" />
    </activity>

    <dialog
        android:id="@+id/loginBottomSheetDialogFragment"
        android:name="com.tatasky.binge.ui.features.onboarding.login.bottomsheet.GuestLoginBottomDialogFragment"
        android:label="LoginBottomSheetDialogFragment">
        <argument
            android:name="isParentalPinSetupRequested"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="isParentalPinVerificaitionRequested"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="isLoggedIn"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="previouslyUsedMobileNumbersList"
            android:defaultValue="@null"
            app:argType="com.tatasky.binge.data.networking.models.response.UsedMobileNumber[]"
            app:nullable="true" />
        <argument
            android:name="loginSource"
            app:argType="string"
            />
        <argument
            android:name="pack"
            app:argType="com.tatasky.binge.data.networking.models.response.PartnerPacks"
            android:defaultValue="@null"
            app:nullable="true"/>
        <argument
            android:name="selectedTenure"
            app:argType="com.tatasky.binge.data.networking.models.response.Tenure"
            android:defaultValue="@null"
            app:nullable="true"/>
        <argument
            android:name="subscriptionInfo"
            app:argType="com.tatasky.binge.data.database.model.SubscriptionInfoModel"
            android:defaultValue="@null"
            app:nullable="true"/>
        <argument
            android:name="isLoginToHome"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_guestLoginBottomDialogFragment_to_managedAppFragment"
            app:destination="@id/managedAppFragment"
            app:launchSingleTop="true" >
            <argument
                android:name="isToSummaryPage"
                android:defaultValue="false"
                app:argType="boolean" />
            <argument
                android:name="cartId"
                android:defaultValue=""
                app:argType="string" />
        </action>
    </dialog>

    <action
        android:id="@+id/action_global_loginBottomSheetDialogFragment"
        app:destination="@id/loginBottomSheetDialogFragment" />
    <action
        android:id="@+id/action_more_info_botttom_sheet"
        app:destination="@id/detailMoreInfoBottomSheetDialogFragment" />
    <action
        android:id="@+id/action_detail_episode_botttom_sheet"
        app:destination="@id/detailEpisodeBottomSheetDialogFragment" />

    <dialog
        android:id="@+id/detailMoreInfoBottomSheetDialogFragment"
        android:name="com.tatasky.binge.ui.features.details.bottomsheet.DetailMoreInfoBottomSheetDialogFragment"
        android:label="DetailMoreInfoBottomSheetDialogFragment"
        tools:layout="@layout/fragment_detail_more_info_bottom_sheet_dialog">

        <argument
            android:defaultValue="@null"
            app:nullable="true"
            android:name="meta"
            app:argType="com.tatasky.binge.data.networking.models.response.MetaDetails" />
    </dialog>
    <dialog
        android:id="@+id/detailEpisodeBottomSheetDialogFragment"
        android:name="com.tatasky.binge.ui.features.details.bottomsheet.DetailEpisodeBottomSheetDialogFragment"
        android:label="DetailEpisodeBottomSheetDialogFragment" >

        <argument
            android:name="contentItem"
            app:argType="com.tatasky.binge.data.networking.models.response.ContentItem"
            app:nullable="false" />

        <argument
            android:name="episodeClick"
            app:argType="com.tatasky.binge.interfaces.EpisodeClickListener"/>

    </dialog>

    <fragment
        android:id="@+id/episodeSeeAllFragment"
        android:name="com.tatasky.binge.ui.features.details.EpisodeSeeAllFragment"
        tools:layout="@layout/fragment_episode_see_all"
        android:label=""
        >
        <argument
            android:name="detailResponse"
            app:argType="com.tatasky.binge.data.networking.models.response.DetailsResponse"
            app:nullable="false" />
        <argument
            android:name="selectedSeason"
            app:argType="integer"
            app:nullable="false"/>
        <argument
            android:name="selectedSeriesId"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="isContentSubscribed"
            app:argType="boolean"
            app:nullable="false"/>
        <action
            android:id="@+id/action_episodeSeeAllFragment_to_episodeVoiceSearch"
            app:destination="@id/episodeVoiceSearch"
            app:popUpToInclusive="false"
            />

    </fragment>
    <action
        android:id="@+id/action_detail_to_episode_see_all"
        app:destination="@id/episodeSeeAllFragment" />

    <fragment
        android:id="@+id/episodeVoiceSearch"
        android:name="com.tatasky.binge.ui.features.details.EpisodeSeeAllVoiceSearchDialogFragment"
        tools:layout="@layout/layout_voice_search_dialog" />

    <dialog
        android:id="@+id/parentalControlBottomDialogFragment"
        android:name="com.tatasky.binge.ui.features.parentalcontrol.bottomsheet.ParentalControlBottomDialogFragment"
        tools:layout="@layout/fragment_parental_control_bottom_dialog">
        <argument
            android:name="actionBeforeOpeningBottomSheet"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="ageRatingValue"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="fromNudge"
            app:argType="boolean"
            android:defaultValue="false"
            app:nullable="false"/>
        <argument
            android:name="source"
            android:defaultValue="PLAY"
            app:argType="string"
            app:nullable="true" />
    </dialog>
    <action
        android:id="@+id/action_global_parentalControlBottomDialogFragment"
        app:destination="@id/parentalControlBottomDialogFragment" />
</navigation>