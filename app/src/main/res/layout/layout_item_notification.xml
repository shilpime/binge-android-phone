<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_9"
        android:layout_marginBottom="@dimen/dp_9"
        >


        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkbox"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_18"
            android:button="@drawable/checkbox_selector"
            android:gravity="center_horizontal"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TouchTargetSizeCheck"
            tools:visibility="visible" />

        <View
            android:id="@+id/bg_notification"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="19dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/checkbox"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_goneMarginStart="0dp" />


        <ImageView
            android:id="@+id/image"
            android:layout_width="100dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/margin_20"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginBottom="@dimen/margin_15"
            android:contentDescription="@string/sample_iv_desc"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/bg_notification"
            app:layout_constraintStart_toStartOf="@+id/bg_notification"
            app:layout_constraintTop_toTopOf="@+id/bg_notification"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/title"
            style="@style/TSTextMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/view_margin_medium"
            android:layout_marginEnd="@dimen/margin_16"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="2"
            android:text="@{contentItem.contentTitle}"
            android:textSize="@dimen/text_size_14"
            app:layout_constraintEnd_toStartOf="@+id/duration"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toTopOf="@+id/image" />

        <com.tatasky.binge.customviews.ExpandableTextView
            android:id="@+id/desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/view_margin_medium"
            android:layout_marginTop="@dimen/view_margin_smallest"
            android:layout_marginEnd="@dimen/margin_20"
            android:lineSpacingExtra="2sp"
            android:paddingBottom="@dimen/margin_10"
            android:text="@{contentItem.description}"
            android:textColor="@color/darkOnSecondary"
            android:textSize="@dimen/text_size_12"
            android:visibility="visible"
            app:etv_EllipsisHint=""
            app:etv_EnableToggle="false"
            app:etv_MaxLinesOnShrink="3"
            app:etv_ToShrinkHintColor="@color/darkPrimary"
            app:etv_ToExpandHintColor="@color/darkPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/bg_notification"
            app:layout_constraintEnd_toStartOf="@+id/iv_provider"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/duration"
            style="@style/TSTextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_9"
            android:layout_marginEnd="@dimen/margin_20"
            android:textColor="@color/darkOnSecondary"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_provider"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/dimens_21dp"
            android:layout_marginBottom="@dimen/margin_10"
            android:maxWidth="64dp"
            android:maxHeight="24dp"
            android:scaleType="fitEnd"
            app:layout_constraintBottom_toBottomOf="@+id/bg_notification"
            app:layout_constraintEnd_toEndOf="@+id/bg_notification"
            tools:visibility="visible" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>