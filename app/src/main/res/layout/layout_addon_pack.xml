<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
    </data>

    <com.tatasky.binge.customviews.CustomMaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/view_margin_smallest">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/view_margin_medium">

            <TextView
                android:id="@+id/tv_app_title"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/view_margin_medium"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_size_18"
                tools:text="Notification Settings" />

            <TextView
                android:id="@+id/tv_app_price"
                style="@style/TSTextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_app_title"
                android:layout_marginStart="@dimen/view_margin_medium"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="7 day free trial"
                android:textColor="?colorOnSecondary"
                android:textSize="@dimen/text_size_14" />

            <ImageView
                android:id="@+id/pack_icon"
                android:layout_width="72dp"
                android:layout_height="@dimen/dimen_48"
                android:layout_below="@id/tv_app_price"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/view_margin_medium"
                android:layout_marginTop="@dimen/view_margin_small"
                android:scaleType="centerCrop" />

            <ToggleButton
                android:id="@+id/desc_toggle"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/desc"
                android:layout_alignStart="@id/tv_app_title"
                android:background="@null"
                android:minWidth="@dimen/margin_0"
                android:minHeight="@dimen/margin_0"
                android:paddingTop="@dimen/view_margin_smallest"
                android:paddingBottom="@dimen/view_margin_smallest"
                android:textAllCaps="false"
                android:textColor="@color/more_color"
                android:textOff="@string/more_info"
                android:textOn="@string/hide"
                android:textSize="@dimen/text_size_14"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_price"
                style="@style/TSTextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/pack_icon"
                android:layout_marginStart="@dimen/view_margin_medium"
                android:layout_marginTop="@dimen/view_margin_small"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_size_14" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_subscribed"
                style="@style/TSTextMedium"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:background="@null"
                android:gravity="center" />
        </RelativeLayout>
    </com.tatasky.binge.customviews.CustomMaterialCardView>
</layout>