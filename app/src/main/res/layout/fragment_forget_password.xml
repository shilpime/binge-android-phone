<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.text.InputType" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/view_margin_form"
            android:layout_marginEnd="@dimen/view_margin_form">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent=".05" />

            <TextView
                android:id="@+id/tv_password_recovery_title"
                style="@style/TSTextMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/enter_verification_code"
                android:textSize="@dimen/text_size_30"
                app:layout_constraintTop_toBottomOf="@id/guideline_2" />

            <TextView
                android:id="@+id/tv_password_subtitle"
                style="@style/TSTextMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_smallest"
                android:gravity="center"
                android:text="@string/password_recovery_subtitle"
                android:textColor="?colorOnSecondary"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintTop_toBottomOf="@id/tv_password_recovery_title" />

            <include
                android:id="@+id/et_otp"
                layout="@layout/layout_edittextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_xxlarge"
                app:headerText="@{@string/enter_4_otp}"
                app:hint="@{@string/otp_hint}"
                app:inputType="@{InputType.TYPE_CLASS_NUMBER}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/tv_password_subtitle"
                app:maxLength="@{6}"
                app:maxLines="@{1}" />

            <include
                android:id="@+id/et_password"
                layout="@layout/layout_edittextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_smallest"
                app:headerText="@{@string/enter_new_password}"
                app:hint="@{@string/password_hint}"
                app:inputType="@{InputType.TYPE_CLASS_TEXT|InputType.TYPE_TEXT_VARIATION_PASSWORD}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/et_otp"
                app:maxLength="@{50}"
                app:maxLines="@{1}" />

            <include
                android:id="@+id/et_confirm_password"
                layout="@layout/layout_edittextbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_smallest"
                app:headerText="@{@string/verify_new_password}"
                app:hint="@{@string/verify_password_hint}"
                app:inputType="@{InputType.TYPE_CLASS_TEXT|InputType.TYPE_TEXT_VARIATION_PASSWORD}"
                app:isVisible="@{true}"
                app:layout_constraintTop_toBottomOf="@id/et_password"
                app:maxLength="@{50}"
                app:maxLines="@{1}" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/view_margin_large"
                android:enabled="false"
                android:text="@string/update"
                app:layout_constraintVertical_chainStyle="spread_inside"
                app:layout_constraintBottom_toTopOf="@id/iv_tbaa"
                app:layout_constraintTop_toBottomOf="@id/et_confirm_password"
                app:layout_constraintVertical_bias="0" />

            <ImageView
                android:id="@+id/iv_tbaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:padding="@dimen/view_margin_xlarge"
                app:layout_constraintTop_toBottomOf="@id/btnUpdatePassword"
                android:contentDescription="@string/sample_iv_desc"
                app:srcCompat="@drawable/small_binge_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/view_margin_xxlarge"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
