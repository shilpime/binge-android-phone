<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem" />
    </data>

    <!--<com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dragFromEdge="left"
        android:layout_marginBottom="@dimen/view_margin_small"
        app:cardCornerRadius="@dimen/margin_0">-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/viewDelete"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal">
                <View android:layout_width="14dp" android:layout_height="2dp"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/delete_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:button="@drawable/checkbox_selector"
                    android:paddingStart="@dimen/view_margin_medium"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="visible" />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frame_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/margin_5"
                android:orientation="horizontal"
                android:paddingStart="@dimen/view_margin_medium"
                android:paddingEnd="@dimen/view_margin_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/view_margin_small"
                    android:paddingBottom="@dimen/view_margin_small"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:button="@drawable/checkbox_selector"
                        android:gravity="center_horizontal"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="112dp"
                        android:layout_height="64dp"
                        android:layout_toEndOf="@+id/checkbox"
                        android:contentDescription="@string/sample_iv_desc"
                        android:scaleType="fitXY"
                        app:layout_constraintStart_toEndOf="@+id/checkbox"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/title"
                        style="@style/TSTextMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/view_margin_medium"
                        android:layout_marginTop="@dimen/margin_6"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:text="@{contentItem.contentTitle}"
                        android:textSize="@dimen/text_size_14"
                        app:layout_constraintEnd_toStartOf="@+id/duration"
                        app:layout_constraintStart_toEndOf="@+id/image"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.tatasky.binge.customviews.ExpandableTextView
                        android:id="@+id/desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/view_margin_medium"
                        android:layout_marginTop="@dimen/view_margin_smallest"
                        android:layout_marginEnd="@dimen/view_margin_xlarge"
                        app:etv_MaxLinesOnShrink="2"
                        app:etv_ToShrinkHintColor="@color/darkPrimary"
                        app:etv_EllipsisHint=" "
                        app:etv_EnableToggle="false"
                        android:lineSpacingExtra="2sp"
                        android:paddingBottom="@dimen/margin_10"
                        android:textColor="@color/darkOnSecondary"
                        android:textSize="@dimen/text_size_12"
                        android:visibility="visible"
                        app:layout_constraintEnd_toStartOf="@+id/iv_provider"
                        app:layout_constraintStart_toEndOf="@+id/image"
                        app:layout_constraintTop_toBottomOf="@+id/title" />

                    <TextView
                        android:id="@+id/duration"
                        style="@style/TSTextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/view_margin_small"
                        android:layout_marginTop="@dimen/margin_6"
                        android:textColor="@color/darkOnSecondary"
                        android:textSize="@dimen/text_size_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_provider"
                        android:layout_width="64dp"
                        android:layout_height="24dp"
                        android:scaleType="fitEnd"
                        android:maxHeight="24dp"
                        android:maxWidth="64dp"
                        android:layout_marginStart="@dimen/view_margin_medium"
                        android:layout_marginTop="@dimen/margin_15"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/darkHighlight"
                    android:contentDescription="@string/sample_iv_desc"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

    </FrameLayout>
    <!--</com.google.android.material.card.MaterialCardView>-->
</layout>
