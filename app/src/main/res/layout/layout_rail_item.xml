<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="firstFreeEpisodeVerbiage"
            type="String" />
        <variable name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem"/>
        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:id="@+id/cardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rlImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/select_overlay"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintEnd_toEndOf="@id/imgCard"
                app:layout_constraintTop_toTopOf="@id/imgCard"
                android:elevation="10dp"
                android:visibility="gone"
                android:background="@drawable/selector_binge_list" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imgCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardElevation="6dp">
                <ImageView
                    android:id="@+id/img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_card"
                    android:contentDescription="@string/sample_iv_desc"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/imgOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_overlay_top10"
                    android:visibility="gone"
                    android:contentDescription="@string/sample_iv_desc"
                    android:scaleType="fitXY" />
                <RelativeLayout
                    android:id="@+id/rlSportsOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_overlay_card"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        android:padding="4dp"
                        android:singleLine="true"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/text_size_9"
                        android:visibility="visible"
                        android:text='@{contentItem.durationForSports}'
                        android:ellipsize="end"
                        android:textAllCaps="false"/>

                    <TextView
                        android:id="@+id/tv_title"
                        style="@style/TSTextMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="@dimen/dimens_6dp"
                        android:padding="4dp"
                        android:maxLines="2"
                        android:letterSpacing="0.03"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/sports_card_text_size"
                        android:visibility="visible"
                        android:text="@{contentItem.title}"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:drawablePadding="6dp"
                        app:drawableStartCompat="@drawable/ic_play_title_rail" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvEpisodeFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="@{firstFreeEpisodeVerbiage}"
                    tools:text="@string/first_episode_free"
                    android:textColor="?colorOnSurface"
                    android:textSize="@dimen/text_size_9"
                    android:textFontWeight="400"
                    android:visibility="@{contentItem.freeEpisodesAvailable &amp;&amp; !contentItem.partnerSubscribed ? View.VISIBLE : View.GONE, default=gone}"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@color/episode_tag_color"/>
                </RelativeLayout>


                <!--If animation required uncomment the include tag-->

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
<!--                    <include-->
<!--                        android:visibility="@{contentItem.liveContent ? View.VISIBLE : View.GONE, default=gone}"-->
<!--                        android:layout_alignParentTop="true"-->
<!--                        android:layout_alignParentEnd="true"-->
<!--                        android:id="@+id/liveTag"-->
<!--                        layout="@layout/layout_live_tag"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        />-->


                    <TextView
                        android:id="@+id/tvLiveTag"
                        style="@style/TSTextBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/live_tag_bg"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:text="@string/live"
                        android:textColor="?colorOnSurface"
                        android:textSize="12sp"
                        android:visibility="@{contentItem.liveContent ? View.VISIBLE : View.GONE, default=gone}"
                        app:drawableStartCompat="@drawable/ic_live_indicator" />
                </RelativeLayout>


            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_crown_small"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:visibility="@{contentItem.containsCrown() ? View.VISIBLE : View.GONE, default=gone}"
            android:layout_margin="4dp"
            app:srcCompat="@drawable/ic_crown_with_bg"
            android:contentDescription="@string/premium_image_desc" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/tv_trending_number"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:visibility="gone"
                android:src="@drawable/ic_top_1"/>
        </RelativeLayout>
        <include
            android:id="@+id/commonDetail"
            layout="@layout/common_rail_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentItem="@{contentItem}"
            android:layout_below="@+id/rlImage"/>
    </RelativeLayout>
</layout>
