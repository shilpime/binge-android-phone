<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="contentItem"
            type="com.tatasky.binge.data.networking.models.response.ContentItem" />


        <import type="android.view.View" />


    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/tab_poup_horizontal_margin">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_episode_info_root"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_background_with_stroke"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/tab_popup_max_width">

            <ImageView
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:translationZ="@dimen/margin_2"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/progress_avd" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_start"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.10" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_end"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.90" />

            <ImageView
                android:id="@+id/view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_bottom_sheet_top_selector" />

            <include
                android:id="@+id/iv_episode"
                layout="@layout/layout_episode_poster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:contentItem="@{contentItem}"
                app:layout_constraintEnd_toEndOf="@id/guideline_end"
                app:layout_constraintStart_toStartOf="@id/guideline_start"
                app:layout_constraintTop_toBottomOf="@id/view" />


            <TextView
                android:id="@+id/tv_episode_title"
                style="@style/TSTextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_xlarge"
                android:gravity="center"
                android:textSize="@dimen/text_size_28"
                app:layout_constraintEnd_toEndOf="@id/guideline_end"
                app:layout_constraintStart_toStartOf="@id/guideline_start"
                app:layout_constraintTop_toBottomOf="@id/iv_episode"
                tools:text="Episode 1: Episode Title. Long title accomodated here" />

            <View
                android:id="@+id/horizontalSeperater"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/view_margin_large"
                android:background="@color/stroke_color"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_episode_title" />


            <TextView
                android:id="@+id/tv_episode_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/view_margin_large"
                android:text="@{contentItem.description}"
                android:textFontWeight="400"
                android:textSize="@dimen/text_size_18"
                app:layout_constraintEnd_toEndOf="@id/guideline_end"
                app:layout_constraintStart_toStartOf="@id/guideline_start"
                app:layout_constraintTop_toBottomOf="@id/horizontalSeperater"
                tools:text="There is a moment in the life of any aspiring astronomer that it is time to buy that space suit and skyrocket into the deepest skies where you will find peace so that saitama finds garou." />


            <TextView
                android:id="@+id/btn_prv_episode"
                style="@style/TSTextBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:drawablePadding="@dimen/margin_8"
                android:gravity="center_vertical"
                android:text="@string/previous_episode_btn"
                android:textColor="@color/tint_pink_light"
                android:textSize="@dimen/text_size_20"
                android:visibility="invisible"
                app:drawableStartCompat="@drawable/ic_prev_arrow"
                app:layout_constraintStart_toStartOf="@id/guideline_start"
                app:layout_constraintTop_toBottomOf="@id/tv_episode_desc"
                tools:visibility="visible" />


            <TextView
                android:id="@+id/btn_nxt_episode"
                style="@style/TSTextBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/next_episode_btn"
                android:textColor="@color/tint_pink_light"
                android:textSize="@dimen/text_size_20"
                android:visibility="invisible"
                app:drawableEndCompat="@drawable/ic_seeall"
                app:layout_constraintEnd_toEndOf="@id/guideline_end"
                app:layout_constraintTop_toBottomOf="@id/tv_episode_desc"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_not_now"
                style="@style/Widget.AppTheme.ButtonStyle.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_16"
                android:text="@string/close"
                android:textSize="@dimen/text_size_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_prv_episode" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
